---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside } from '@astrojs/starlight/components';
import ItemIcon from '../../components/ItemIcon.astro';
import BiomeBadge from '../../components/BiomeBadge.astro';
import ItemTooltip from '../../components/ItemTooltip.astro';
import CraftingSlots from '../../components/CraftingSlots.astro';
import RuneDivider from '../../components/RuneDivider.astro';
import Rune from '../../components/Rune.astro';
import { getItems, url, slugify, totalDamage, modName, biomeIndex, tierIndex, tierInfo, repoUrl, type Item } from '../../lib/wiki';

export async function getStaticPaths() {
  const items = await getItems();
  return items.map((item) => ({ params: { slug: item.id }, props: { item, all: items } }));
}
interface Props { item: Item; all: Item[] }
const { item, all } = Astro.props;
const d = item.data;
const max = Math.max(...all.map(totalDamage));

const family = all
  .filter((i) => i.data.group === d.group && i.data.mod === d.mod)
  .sort((a, b) => tierIndex(a.data.tier) - tierIndex(b.data.tier) || biomeIndex(a.data.biome) - biomeIndex(b.data.biome) || totalDamage(a) - totalDamage(b));
const tier = tierInfo(d.tier);
const pos = family.findIndex((i) => i.id === item.id);
const prev = family[pos - 1];
const next = family[pos + 1];
const repo = repoUrl;
---
<StarlightPage frontmatter={{ title: d.name, description: `${d.name} (${d.prefab}) from ${modName(d.mod)}.`, tableOfContents: false }}>
  <div class="item-hero not-content">
    <ItemIcon prefab={d.prefab} name={d.name} biome={d.biome} size={96} />
    <div class="item-hero__body">
      <div class="item-hero__meta">
        <a class="pill" href={url(`/${d.mod}/`)}>{modName(d.mod)}</a>
        <a class="pill" href={url(`/${d.mod}/weapons/#group-${slugify(d.group)}`)}>{d.group}</a>
        {d.skill && <span class="pill">{d.skill} skill</span>}
        {tier && <a class="pill pill--tier" href={url(`/${d.mod}/#tier-${tier.id.toLowerCase()}`)}><Rune r={tier.rune} />{tier.id} tier</a>}
        <BiomeBadge biome={d.biome} guessed={d.biome_guessed} />
      </div>
      <p class="prefab">
        <code data-copy={d.prefab}>{d.prefab}</code>
        <button class="copy-btn" data-copy-btn={d.prefab} aria-label="Copy prefab name">copy</button>
      </p>
      {d.description && <p class="item-hero__desc">{d.description}</p>}
      {tier && <p class="item-hero__tier"><Rune r={tier.rune} /> {tier.text}</p>}
    </div>
  </div>

  {d.checks.length > 0 && (
    <Aside type="caution" title="To check">
      <ul>{d.checks.map((c) => <li>{c}</li>)}</ul>
      {d.source && <p class="small">Sheet: {d.source.sheet}, row {d.source.row}</p>}
    </Aside>
  )}

  <div class="item-grid not-content">
    <section class="panel panel--tooltip">
      <h2>In-game</h2>
      <ItemTooltip item={item} />
    </section>

    <section class="panel panel--craft">
      <h2>Crafting {d.recipe.yields > 1 && <span class="panel__total">makes {d.recipe.yields}</span>}</h2>
      {d.recipe.station && <p class="muted">{d.recipe.station}{d.recipe.level ? ` level ${d.recipe.level}` : ''}</p>}
      {d.recipe.materials.length ? <CraftingSlots materials={d.recipe.materials} /> : <p class="muted">No recipe in the spreadsheet yet.</p>}
      {d.recipe.monstrum && (
        <div class="monstrum">
          <h3>With Monstrum installed</h3>
          <CraftingSlots materials={d.recipe.monstrum} variant="monstrum" />
        </div>
      )}
      <p class="small slots-note">Quantities are not in the spreadsheet yet.</p>
    </section>
  </div>



  {(d.notes || d.tips?.length) && (
    <section class="panel panel--notes not-content">
      <h2>Notes</h2>
      {d.notes && <p>{d.notes}</p>}
      {d.tips && <ul>{d.tips.map((t) => <li>{t}</li>)}</ul>}
    </section>
  )}

  <RuneDivider seed={d.name.length} />

  <section class="family not-content">
    <h2>{d.group} progression</h2>
    <ol class="family__line">
      {family.map((f) => (
        <li class:list={{ 'is-current': f.id === item.id }}>
          <a href={url(`/items/${f.id}/`)}>
            <ItemIcon prefab={f.data.prefab} name={f.data.name} biome={f.data.biome} size={40} />
            <span>{f.data.name}</span>
            <small>{totalDamage(f)}</small>
          </a>
        </li>
      ))}
    </ol>
    <nav class="family__nav">
      {prev ? <a href={url(`/items/${prev.id}/`)}>← {prev.data.name}</a> : <span />}
      {next ? <a href={url(`/items/${next.id}/`)}>{next.data.name} →</a> : <span />}
    </nav>
  </section>

  <p class="edit-item small">
    <a href={`${repo}/edit/main/src/data/items/${item.id}.yaml`}>Edit this item on GitHub</a> ·
    <a href={url('/admin/')}>Open the editor</a>
  </p>
</StarlightPage>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-btn]').forEach((b) =>
    b.addEventListener('click', async () => {
      await navigator.clipboard?.writeText(b.dataset.copyBtn!);
      b.textContent = 'copied';
      setTimeout(() => (b.textContent = 'copy'), 1200);
    })
  );
</script>
