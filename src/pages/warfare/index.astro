---
// Warfare overview: a navigation panel with a short summary of every topic.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getItems, url } from '../../lib/wiki';
import { LINKS, GUIDE } from '../../lib/warfare';

const items = await getItems('warfare');
const art = (f: string) => url(`/readme/warfare/${f}`);
const count = (sheet: string) => items.filter((i) => i.data.source?.sheet === sheet).length;
const browse = [
  { href: '/warfare/weapons/', title: 'Weapons', text: 'Every weapon, shield and ammo type with damage, recipe and biome.', n: count('Weapons') },
  { href: '/warfare/pieces/', title: 'Pieces', text: 'Crafting stations, extensions and build pieces.', n: count('Pieces') },
  { href: '/warfare/items/', title: 'Items', text: 'Materials, meads, quivers and the rest.', n: count('Items') },
];

// Old links pointed at anchors on one long page; send them to the topic page.
const OLD = { 'the-forge-path': 'forge-path', 'relics-of-the-forsaken': 'relics', 'the-arsenal': 'arsenal', 'eitr-infusion': 'runeforge',
  'the-fletchers-hall': 'fletchers-hall', 'and-more': 'more', 'the-therzie-saga': 'saga', 'install-notes': 'install',
  'the-crafting-filter': 'crafting-filter', 'prefab-names': 'install', 'languages': 'install', 'roadmap': 'credits', 'credits': 'credits', 'support': 'credits' };
---
<StarlightPage frontmatter={{ title: 'Warfare', description: 'Weapons for every biome, from Meadows flint to Ashlands flametal.', tableOfContents: false }}>
  <div class="readme not-content">
    <div class="readme__logo"><img src={art('warfare.png')} alt="Warfare" width="524" height="180" /></div>
    <p class="readme__motto">The Allfather demands glory. Warfare forges the weapons to earn it.</p>
    <p class="readme__intro">
      Over twenty classes of weaponry, forged in every biome from Meadows flint to Ashlands flametal.
      Master them in combat, fall with honor and claim your seat in Valhalla.
    </p>
    <p class="readme__links">
      <a href={LINKS.discord}>Discord</a> · <a href={LINKS.patreon}>Patreon</a> · <a href={url('/warfare/weapons/')}>All weapons</a>
    </p>

    <figure class="raven raven--hugin">
      <img src={art('hugin.png')} alt="" width="64" height="64" />
      <blockquote><b>Hugin:</b> <i>"Greetings, warrior. The Allfather loves nothing more than the clash of steel, and only those who fall in glorious combat will feast in his hall. Valhalla is not given, it is earned in battle. Arm yourself well. Odin is watching."</i></blockquote>
    </figure>

    <h2 class="guide-head">Browse the database</h2>
    <div class="guide-grid guide-grid--browse">
      {browse.map((b) => (
        <a class="guide-card guide-card--browse" href={url(b.href)}>
          <span class="guide-card__title">{b.title}</span>
          <span class="guide-card__text">{b.text}</span>
          <span class="guide-card__stat">{b.n} entries</span>
        </a>
      ))}
    </div>

    <h2 class="guide-head">Learn the mod</h2>
    <div class="guide-grid">
      {GUIDE.map((g) => (
        <a class="guide-card" href={url(`/warfare/${g.slug}/`)}>
          <span class="guide-card__rune" aria-hidden="true">{g.rune}</span>
          <span class="guide-card__title">{g.title}</span>
          <span class="guide-card__text">{g.summary}</span>
          {g.stat && <span class="guide-card__stat">{g.stat}</span>}
        </a>
      ))}
    </div>

    <p class="readme__sign">Made by Therzie · Skål!</p>
    <script is:inline define:vars={{ OLD, base: url('/warfare/') }}>
      const id = location.hash.slice(1);
      if (OLD[id]) location.replace(base + OLD[id] + '/');
      else if (id.startsWith('tier-')) location.replace(base + 'forge-path/#' + id);
    </script>
  </div>
</StarlightPage>
