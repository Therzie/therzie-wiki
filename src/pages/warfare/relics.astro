---
import WarfarePage from '../../components/warfare/WarfarePage.astro';
import ItemIcon from '../../components/ItemIcon.astro';
import { url, getItems } from '../../lib/wiki';
const art = (f: string) => url(`/readme/warfare/${f}`);
const order = ['Eikthyr', 'The Elder', 'Bonemass', 'Moder', 'Yagluth', 'The Queen', 'Fader'];
const relics = (await getItems('warfare'))
  .filter((i) => i.data.info?.some((x) => x.startsWith('Relic of ')))
  .map((i) => ({ item: i, boss: i.data.info!.find((x) => x.startsWith('Relic of '))!.slice(9) }))
  .sort((a, b) => order.indexOf(a.boss) - order.indexOf(b.boss));
---
<WarfarePage slug="relics">

    <figure class="raven raven--munin">
      <img src={art('munin.png')} alt="" width="64" height="64" />
      <blockquote><b>Munin:</b> <i>"I remember every one of them. The stag, the ancient tree, the rotting mass, the dragon, the burning skull, the queen beneath the mist and the one who waits in the ash. Each left something behind."</i></blockquote>
    </figure>
<p>Each of the Forsaken guards a weapon of its own. They are rare drops, so you may have to call the boss more than once.</p>
    <table class="item-table readme-table relics-table">
      <thead><tr><th>Forsaken</th><th>Relic</th><th>Class</th><th>Drop chance</th></tr></thead>
      <tbody>{relics.map(({ item, boss }) => (
        <tr>
          <td>{boss}</td>
          <td class="relic"><a class="item-link" href={url(`/items/${item.id}/`)}><ItemIcon prefab={item.data.prefab} name={item.data.name} biome={item.data.biome} size={28} /> {item.data.name}</a></td>
          <td>{item.data.group.replace(/s$/, '')}</td>
          <td>{item.data.drops?.find((d) => d.from === boss)?.chance ?? ''}</td>
        </tr>
      ))}</tbody>
    </table>
</WarfarePage>
