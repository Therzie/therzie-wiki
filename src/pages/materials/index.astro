---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getItems, materialIndex, url } from '../../lib/wiki';

const mats = materialIndex(await getItems());
const letters = [...new Set(mats.map((m) => m.name[0].toUpperCase()))];
---
<StarlightPage frontmatter={{ title: 'Materials', description: 'Every material from the recipes and what you can make with it.', tableOfContents: false }}>
  <p class="lead">Every material from the recipes. Open one to see what you can make with it, and where it comes from when it is an item on this wiki.</p>
  <input type="search" class="mat-search" placeholder="Find a material…" data-mat-search aria-label="Find a material" />
  <nav class="group-jump not-content" aria-label="Jump to letter">{letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}</nav>
  <div class="not-content">
    {letters.map((l) => (
      <section class="mat-letter" id={`letter-${l}`} data-letter>
        <h2 class="group__title">{l}</h2>
        <ul class="mat-list">
          {mats.filter((m) => m.name[0].toUpperCase() === l).map((m) => (
            <li data-name={m.name.toLowerCase()}>
              <a href={url(`/materials/${m.slug}/`)}>{m.name}</a>
              <span class="group__count">{m.uses.length}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</StarlightPage>
<script>
  const input = document.querySelector<HTMLInputElement>('[data-mat-search]')!;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('.mat-list li').forEach((li) => (li.hidden = !!q && !li.dataset.name!.includes(q)));
    document.querySelectorAll<HTMLElement>('[data-letter]').forEach((s) => (s.hidden = !s.querySelector('li:not([hidden])')));
  });
</script>
