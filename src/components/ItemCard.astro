---
import type { Item } from '../lib/wiki';
import { url, totalDamage, slugify, tierInfo, statLabel } from '../lib/wiki';
import ItemIcon from './ItemIcon.astro';
import BiomeBadge from './BiomeBadge.astro';
import Rune from './Rune.astro';
import DamageBars from './DamageBars.astro';
interface Props { item: Item; max: number }
const { item } = Astro.props;
const d = item.data;
const tier = tierInfo(d.tier);
// cards keep it short; the item page shows every stat
const CARD_SKIP = new Set(['levels', 'knockback', 'backstab', 'durability', 'movement', 'weight', 'max_level', 'secondary_stamina', 'block_force', 'reload']);
const stats = Object.entries(d.stats ?? {}).filter(([k]) => !CARD_SKIP.has(k) && !(k === 'block_armor' && d.kind === 'weapon'));
const weak = Object.entries(d.creature?.resist ?? {}).filter(([, v]) => /weak/.test(v)).map(([k]) => k);
const immune = Object.entries(d.creature?.resist ?? {}).filter(([, v]) => v === 'immune').map(([k]) => k);
const search = [d.name, d.prefab ?? '', d.group, d.tier ?? '', d.biome ?? '', d.set?.name ?? '', ...d.recipe.materials, ...(d.drops ?? []).map((x) => x.from)]
  .join(' ').toLowerCase();
---
<a class="card-item" href={url(`/items/${item.id}/`)}
   data-biome={d.biome ?? ''} data-group={slugify(d.group)} data-search={search} data-total={totalDamage(item)}>
  <div class="card-item__head">
    <ItemIcon prefab={d.prefab} name={d.name} biome={d.biome} />
    <div>
      <h3>{d.name}</h3>
      {d.prefab && <code>{d.prefab}</code>}
    </div>
  </div>
  <div class="card-item__meta">
    {tier && <span class="pill pill--tier" title={`${tier.id} tier`}><Rune r={tier.rune} />{tier.id}</span>}
    {d.biome && <BiomeBadge biome={d.biome} guessed={d.biome_guessed} />}
    {d.recipe.yields > 1 && <span class="pill">x{d.recipe.yields}</span>}
    {d.checks.length > 0 && <span class="pill pill--warn" title={d.checks.join('\n')}>check</span>}
  </div>
  {Object.keys(d.damage).length > 0 && <DamageBars damage={d.damage} max={d.damage_max} compact />}
  {d.food && (
    <ul class="stats stats--compact">
      {(['health', 'stamina', 'eitr'] as const).filter((k) => d.food?.[k] !== undefined).map((k) => <li><span class="stats__label">{k[0].toUpperCase() + k.slice(1)}</span><span class="stats__value">{d.food?.[k]}</span></li>)}
    </ul>
  )}
  {d.creature && (
    <ul class="stats stats--compact">
      {d.creature.health !== undefined && <li><span class="stats__label">Health</span><span class="stats__value">{d.creature.health}</span></li>}
      {weak.length > 0 && <li><span class="stats__label">Weak to</span><span class="stats__value">{weak.join(', ')}</span></li>}
      {immune.length > 0 && <li><span class="stats__label">Immune</span><span class="stats__value">{immune.join(', ')}</span></li>}
    </ul>
  )}
  {stats.length > 0 && (
    <ul class="stats stats--compact">
      {stats.map(([k, v]) => <li><span class="stats__label">{statLabel(k)}</span><span class="stats__value">{v}</span></li>)}
    </ul>
  )}
  {d.drops && d.drops.length > 0 && d.creature && (
    <div class="card-item__loot"><span>Drops:</span><ul>{d.drops.map((x) => <li>{x.from}{x.chance && ` - ${x.chance}`}</li>)}</ul></div>
  )}
  {d.drops && d.drops.length > 0 && !d.creature && (
    <p class="card-item__drops">Drops from {d.drops.slice(0, 3).map((x) => `${x.from}${x.chance ? ` ${x.chance}` : ''}`).join(', ')}{d.drops.length > 3 && ` +${d.drops.length - 3}`}</p>
  )}
  {d.effect && <p class="card-item__effect">{d.effect}</p>}
</a>
