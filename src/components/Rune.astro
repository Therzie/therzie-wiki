---
// One rune. Some runes (kaun ᚲ, ing ᛜ) are drawn much smaller than the rest in the runic font;
// those get scaled up so every rune reads at the same height.
interface Props { r: string; class?: string }
const { r, class: cls } = Astro.props;
const small = r === 'ᚲ' ? 'kaun' : r === 'ᛜ' ? 'ing' : undefined;
---
<span class:list={['rune', cls, small && `rune--${small}`]}>{r}</span>
